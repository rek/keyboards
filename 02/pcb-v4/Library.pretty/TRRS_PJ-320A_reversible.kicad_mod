(module TRRS_PJ-320A_reversible (layer F.Cu) (tedit 00000002)
  (descr "TRRS PJ-320A reversible — silkscreen and courtyard on both sides")
  (tags "TRRS audio jack reversible")
  (attr through_hole)
  (fp_text reference REF** (at 0 -14.2) (layer F.Fab) hide
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value TRRS (at 0 5.6) (layer F.Fab) hide
    (effects (font (size 1 1) (thickness 0.15)))
  )

  ; Body outline — F.SilkS (front, for right-half assembly)
  (fp_line (start 3.05 0) (end 3.05 -12.1) (layer F.SilkS) (width 0.15))
  (fp_line (start -3.05 0) (end -3.05 -12.1) (layer F.SilkS) (width 0.15))
  (fp_line (start 3.05 0) (end -3.05 0) (layer F.SilkS) (width 0.15))
  (fp_line (start 3.05 -12.1) (end -3.05 -12.1) (layer F.SilkS) (width 0.15))
  (fp_line (start 2.8 2) (end -2.8 2) (layer F.SilkS) (width 0.15))
  (fp_line (start 2.8 0) (end 2.8 2) (layer F.SilkS) (width 0.15))
  (fp_line (start -2.8 0) (end -2.8 2) (layer F.SilkS) (width 0.15))

  ; Body outline — B.SilkS (back, for left-half assembly)
  (fp_line (start 3.05 0) (end 3.05 -12.1) (layer B.SilkS) (width 0.15))
  (fp_line (start -3.05 0) (end -3.05 -12.1) (layer B.SilkS) (width 0.15))
  (fp_line (start 3.05 0) (end -3.05 0) (layer B.SilkS) (width 0.15))
  (fp_line (start 3.05 -12.1) (end -3.05 -12.1) (layer B.SilkS) (width 0.15))
  (fp_line (start 2.8 2) (end -2.8 2) (layer B.SilkS) (width 0.15))
  (fp_line (start 2.8 0) (end 2.8 2) (layer B.SilkS) (width 0.15))
  (fp_line (start -2.8 0) (end -2.8 2) (layer B.SilkS) (width 0.15))

  ; Courtyard — F.CrtYd
  (fp_line (start -3.5 2.5) (end 3.5 2.5) (layer F.CrtYd) (width 0.05))
  (fp_line (start 3.5 2.5) (end 3.5 -12.5) (layer F.CrtYd) (width 0.05))
  (fp_line (start 3.5 -12.5) (end -3.5 -12.5) (layer F.CrtYd) (width 0.05))
  (fp_line (start -3.5 -12.5) (end -3.5 2.5) (layer F.CrtYd) (width 0.05))

  ; Courtyard — B.CrtYd
  (fp_line (start -3.5 2.5) (end 3.5 2.5) (layer B.CrtYd) (width 0.05))
  (fp_line (start 3.5 2.5) (end 3.5 -12.5) (layer B.CrtYd) (width 0.05))
  (fp_line (start 3.5 -12.5) (end -3.5 -12.5) (layer B.CrtYd) (width 0.05))
  (fp_line (start -3.5 -12.5) (end -3.5 2.5) (layer B.CrtYd) (width 0.05))

  ; Mechanical mount holes (no copper)
  (pad "" np_thru_hole circle (at 0 -8.6) (size 0.8 0.8) (drill 0.8) (layers *.Cu *.Mask))
  (pad "" np_thru_hole circle (at 0 -1.6) (size 0.8 0.8) (drill 0.8) (layers *.Cu *.Mask))

  ; Signal pins — all on *.Cu so they route from either side
  (pad 1 thru_hole oval (at -2.3 -11.3) (size 1.6 2) (drill oval 0.9 1.3) (layers *.Cu *.Mask))
  (pad 2 thru_hole oval (at 2.3 -10.2) (size 1.6 2) (drill oval 0.9 1.3) (layers *.Cu *.Mask))
  (pad 3 thru_hole oval (at 2.3 -6.2) (size 1.6 2) (drill oval 0.9 1.3) (layers *.Cu *.Mask))
  (pad 4 thru_hole oval (at 2.3 -3.2) (size 1.6 2) (drill oval 0.9 1.3) (layers *.Cu *.Mask))
)
